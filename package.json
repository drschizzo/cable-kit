{
  "name": "cable-kit",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Thousands of cables for three.js: an AVBD cable solver in a Web Worker, and tubes swept on the GPU",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build -w @drschizzo/avbd-cables -w @drschizzo/three-cable-tubes",
    "build:examples": "vite build",
    "lint": "eslint .",
    "typecheck": "tsc",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm test",
    "presets": "vite-node tools/presets.ts",
    "pack": "npm run build && npm pack --dry-run -w @drschizzo/avbd-cables -w @drschizzo/three-cable-tubes"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@types/three": "^0.183.1",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "three": "^0.183.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.0.0",
    "vite-node": "^3.2.4",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20"
  }
}
